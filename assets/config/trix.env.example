# Trix Agent — секреты и ключи.
# Здесь только то, что нужно для запуска. Остальные настройки — в
# config.yaml рядом.

# ============================================================
# ОБЯЗАТЕЛЬНО ЗАПОЛНИТЬ — без этого агент не будет работать
# ============================================================

# 1. Токен Telegram-бота. Получить у @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# 2. Ваш Telegram user id. Узнать: напишите @userinfobot.
#    Несколько — через запятую. Пустое значение = доступ закрыт для всех.
TELEGRAM_ALLOWED_USERS=

# 3. Ключ провайдера модели — заполните ОДИН из двух.
#    OpenRouter (много моделей одним ключом): https://openrouter.ai/keys
OPENROUTER_API_KEY=
#    z.ai / GLM: https://z.ai
GLM_API_KEY=

# ============================================================
# ПО ЖЕЛАНИЮ — можно не трогать
# Чтобы включить любую из строк ниже, уберите "#" в её начале и впишите
# значение.
# ============================================================

# Чат, куда агент присылает результаты задач по расписанию.
# Проще не заполнять руками: отправьте боту /sethome в нужном чате.
# TELEGRAM_HOME_CHANNEL=

# Прокси только для Telegram, если api.telegram.org недоступен напрямую.
# Формат: socks5://user:pass@host:port или http://host:port
# TELEGRAM_PROXY=

# Полноценное извлечение веб-страниц (платно). Без ключа агент читает
# страницы браузером — медленнее, но бесплатно. Одного ключа здесь мало:
# в config.yaml, в списке platform_toolsets.telegram, замените "search"
# на "web" — иначе инструмент не появится у агента.
# FIRECRAWL_API_KEY=

# Генерация изображений (платно): https://fal.ai
# FAL_KEY=

# ============================================================
# ЗАПОЛНЕНО НАМИ — менять не нужно
# ============================================================

# Локальные и напрямую доступные из РФ-дата-центра адреса — идут мимо
# прокси, даже если вы его укажете (мастер настройки допишет HTTPS_PROXY
# сюда же сам, при указании прокси на шаге "Прокси" — вручную ничего
# вписывать не нужно).
NO_PROXY=localhost,127.0.0.1,::1,api.z.ai,api.deepseek.com,generativelanguage.googleapis.com,api.search.brave.com,api.parallel.ai,api.firecrawl.dev
no_proxy=localhost,127.0.0.1,::1,api.z.ai,api.deepseek.com,generativelanguage.googleapis.com,api.search.brave.com,api.parallel.ai,api.firecrawl.dev
