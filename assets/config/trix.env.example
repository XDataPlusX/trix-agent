# Trix Agent — секреты и ключи.
# Здесь только то, что нужно для запуска. Остальные настройки — в
# config.yaml рядом.

# ============================================================
# ОБЯЗАТЕЛЬНО ЗАПОЛНИТЬ — без этого агент не будет работать
# ============================================================

# 1. Токен Telegram-бота. Получить у @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# 2. Ваш Telegram user id. Узнать: напишите @userinfobot.
#    Несколько — через запятую. Пустое значение = доступ закрыт для всех.
TELEGRAM_ALLOWED_USERS=

# 3. Ключ провайдера модели — заполните ОДИН из двух.
#    OpenRouter (много моделей одним ключом): https://openrouter.ai/keys
OPENROUTER_API_KEY=
#    z.ai / GLM: https://z.ai
GLM_API_KEY=

# ============================================================
# ПО ЖЕЛАНИЮ — можно не трогать
# Чтобы включить любую из строк ниже, уберите "#" в её начале и впишите
# значение.
# ============================================================

# Чат, куда агент присылает результаты задач по расписанию.
# Проще не заполнять руками: отправьте боту /sethome в нужном чате.
# TELEGRAM_HOME_CHANNEL=

# Прокси только для Telegram, если api.telegram.org недоступен напрямую.
# Формат: socks5://user:pass@host:port или http://host:port
# TELEGRAM_PROXY=

# Полноценное извлечение веб-страниц (платно). Без ключа агент читает
# страницы браузером — медленнее, но бесплатно. Одного ключа здесь мало:
# в config.yaml, в списке platform_toolsets.telegram, замените "search"
# на "web" — иначе инструмент не появится у агента.
# FIRECRAWL_API_KEY=

# Генерация изображений (платно): https://fal.ai
# FAL_KEY=

# ============================================================
# ЗАПОЛНЕНО НАМИ — менять не нужно
# ============================================================

# Локальные и напрямую доступные из РФ-дата-центра адреса — идут мимо
# прокси, даже если вы его укажете (мастер настройки допишет HTTPS_PROXY
# сюда же сам, при указании прокси на шаге "Прокси" — вручную ничего
# вписывать не нужно).
NO_PROXY=localhost,127.0.0.1,::1,api.z.ai,api.deepseek.com,generativelanguage.googleapis.com,api.search.brave.com,api.parallel.ai,api.firecrawl.dev
no_proxy=localhost,127.0.0.1,::1,api.z.ai,api.deepseek.com,generativelanguage.googleapis.com,api.search.brave.com,api.parallel.ai,api.firecrawl.dev

# ==== ПОЛНЫЙ СПИСОК ОСТАЛЬНЫХ ПЕРЕМЕННЫХ (сгенерировано) ====
#
# Ниже — все остальные переменные, которые понимает агент. Каждая
# закомментирована: пока решётка на месте, переменной для программы
# не существует. Чтобы включить — уберите решётку и впишите значение.
#
# Правьте только кураторскую часть выше; этот список пересобирается
# командой python3 scripts/build_trix_env.py.
#
# Каналы связи, кроме Telegram, здесь не перечислены: продукт работает
# через Telegram, и остальные каналы связи в поставку не входят. Агент их
# умеет — Slack, Matrix, почта и ещё полтора десятка; если понадобится,
# это делается на нашей стороне, а не строкой в этом файле.
#
# Настроек поведения здесь нет вовсе — ни таймаутов, ни отладки, ни
# порогов сжатия. В этом файле живут только ключи и пароли, всё остальное
# — в config.yaml рядом.
#
# Строки под пароль root тут тоже нет, и это намеренно: sudo с машины
# снят, а пароль в открытом файле прочитает любой, у кого есть доступ к
# машине.

# ──────────────────────────────────────────────────────────────────────────
# Ключи провайдеров моделей (70)
# ──────────────────────────────────────────────────────────────────────────

# Адрес другого портала моделей (нужен свой аккаунт там).
# NOUS_BASE_URL=

# Google AI Studio API key (also recognized as GEMINI_API_KEY)
#   https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=

# Google AI Studio API key (alias for GOOGLE_API_KEY)
#   https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=

# Google AI Studio base URL override
# GEMINI_BASE_URL=

# Путь к JSON сервисного аккаунта Google Cloud для Vertex AI (Gemini).
# Vertex работает по OAuth2, а не по постоянному ключу: агент сам
# выписывает короткоживущие токены по этому файлу. Если не указан —
# берётся GOOGLE_APPLICATION_CREDENTIALS, затем ADC (gcloud auth
# application-default login). Проект и регион — в config.yaml, раздел
# vertex.
#   https://cloud.google.com/iam/docs/keys-create-delete
# VERTEX_CREDENTIALS_PATH=

# xAI API key
#   https://console.x.ai/
# XAI_API_KEY=

# xAI base URL override
# XAI_BASE_URL=

# NVIDIA NIM API key (build.nvidia.com or local NIM endpoint)
#   https://build.nvidia.com/
# NVIDIA_API_KEY=

# NVIDIA NIM base URL override (e.g. http://localhost:8000/v1 for local
# NIM)
# NVIDIA_BASE_URL=

# LM Studio bearer token for auth-enabled local servers
# LM_API_KEY=

# LM Studio base URL override
# LM_BASE_URL=

# Z.AI API key (alias for GLM_API_KEY)
#   https://z.ai/
# ZAI_API_KEY=

# Z.AI API key (alias for GLM_API_KEY)
#   https://z.ai/
# Z_AI_API_KEY=

# Z.AI / GLM base URL override
# GLM_BASE_URL=

# Kimi / Moonshot API key
#   https://platform.moonshot.cn/
