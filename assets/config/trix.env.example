# ──────────────────────────────────────────────────────────────────────────
# Ключи инструментов (38)
# поиск, извлечение страниц, картинки, браузер, распознавание речи
# ──────────────────────────────────────────────────────────────────────────

# Exa API key for AI-native web search and contents
#   https://exa.ai/
# EXA_API_KEY=

# Parallel API key for AI-native web search and extract
#   https://parallel.ai/
# PARALLEL_API_KEY=

# Firecrawl API URL for self-hosted instances (optional)
# FIRECRAWL_API_URL=

# Адрес шлюза Firecrawl. Нужен только при подписке на сторонний тариф,
# который такой шлюз предоставляет — при обычном ключе Firecrawl не нужен.
# FIRECRAWL_GATEWAY_URL=

# Домен общего шлюза инструментов — из того же стороннего тарифа, что и
# строка выше. При обычных ключах не нужен.
# TOOL_GATEWAY_DOMAIN=

# Схема адреса того же шлюза (по умолчанию https; http — только для
# локальной отладки).
# TOOL_GATEWAY_SCHEME=

# Токен доступа к тому же шлюзу инструментов. Обычно не нужен: если тариф
# подключён, токен берётся из сохранённого входа.
# TOOL_GATEWAY_USER_TOKEN=

# Tavily API key for AI-native web search and extract
#   https://app.tavily.com/home
# TAVILY_API_KEY=

# URL of your SearXNG instance for free self-hosted web search
#   https://searxng.github.io/searxng/
# SEARXNG_URL=

# Brave Search API subscription token (free tier: 2,000 queries/mo)
#   https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=

# Browserbase API key for cloud browser (optional — local browser works
# without this)
#   https://browserbase.com/
# BROWSERBASE_API_KEY=

# Browserbase project ID (optional — only needed for cloud browser)
#   https://browserbase.com/
# BROWSERBASE_PROJECT_ID=

# Browser Use API key for cloud browser (optional — local browser works
# without this)
#   https://browser-use.com/
# BROWSER_USE_API_KEY=

# Firecrawl browser session TTL in seconds (optional, default 300)
# FIRECRAWL_BROWSER_TTL=

# Browser engine for local mode: auto (default Chrome), lightpanda
# (faster, no screenshots), chrome
#   https://github.com/vercel-labs/agent-browser
# AGENT_BROWSER_ENGINE=

# Camofox browser server URL for local anti-detection browsing (e.g.
# http://localhost:9377)
#   https://github.com/jo-inc/camofox-browser
# CAMOFOX_URL=

# Optional bearer token sent as Authorization header to a
# remote/authenticated Camofox server
#   https://github.com/jo-inc/camofox-browser
# CAMOFOX_API_KEY=

# Krea API key for Krea 2 image generation (Medium + Large)
#   https://www.krea.ai/settings/api-tokens
# KREA_API_KEY=

# OpenAI API key for voice transcription (Whisper) and OpenAI TTS
#   https://platform.openai.com/api-keys
# VOICE_TOOLS_OPENAI_KEY=

# ElevenLabs API key for premium text-to-speech voices and Scribe
# transcription
#   https://elevenlabs.io/
# ELEVENLABS_API_KEY=

# Mistral API key for Voxtral TTS and transcription (STT)
#   https://console.mistral.ai/
# MISTRAL_API_KEY=

# Ключ Picovoice для платного распознавателя ключевого слова (Porcupine,
# слово-активатор 'Hey Hermes'). По умолчанию работает бесплатный
# openWakeWord — ключ не нужен.
#   https://console.picovoice.ai/
# PORCUPINE_ACCESS_KEY=

# GitHub token for Skills Hub (higher API rate limits, skill publish)
#   https://github.com/settings/tokens
# GITHUB_TOKEN=

# Honcho API key for AI-native persistent memory
#   https://app.honcho.dev
# HONCHO_API_KEY=

# Base URL for self-hosted Honcho instances (no API key needed)
# HONCHO_BASE_URL=

# Hindsight API key for graph-aware persistent memory
#   https://hindsight.vectorize.io
# HINDSIGHT_API_KEY=

# Base URL for the Hindsight API (default:
# https://api.hindsight.vectorize.io)
# HINDSIGHT_API_URL=

# Supermemory API key for conversation-scoped persistent memory
#   https://supermemory.ai
# SUPERMEMORY_API_KEY=

# Mem0 Platform API key for semantic persistent memory
#   https://app.mem0.ai
# MEM0_API_KEY=

# RetainDB API key for persistent memory
#   https://retaindb.com
# RETAINDB_API_KEY=

# Base URL for self-hosted RetainDB instances (default:
# https://api.retaindb.com)
# RETAINDB_BASE_URL=

# ByteRover API key (optional, for cloud sync — local-first by default)
#   https://app.byterover.dev
# BRV_API_KEY=

# OpenViking API key (leave blank for local dev mode)
# OPENVIKING_API_KEY=

# OpenViking server URL (default: http://127.0.0.1:1933)
# OPENVIKING_ENDPOINT=

# Langfuse project public key (pk-lf-...)
#   https://cloud.langfuse.com
# HERMES_LANGFUSE_PUBLIC_KEY=

# Langfuse project secret key (sk-lf-...)
#   https://cloud.langfuse.com
# HERMES_LANGFUSE_SECRET_KEY=

# Langfuse server URL (default: https://cloud.langfuse.com)
# HERMES_LANGFUSE_BASE_URL=

# Ключ Groq — бесплатное распознавание речи в голосовых сообщениях. Без
# него голос распознаётся на самой машине (медленнее) или не распознаётся
# вовсе.
#   https://console.groq.com/keys
# GROQ_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Telegram и общие настройки связи (6)
# самое нужное — в начале файла; здесь то, что требуется редко
# ──────────────────────────────────────────────────────────────────────────

# Пускать к агенту кого угодно, не спрашивая (true/false, по умолчанию
# false). Включать не нужно: тогда любой, кто найдёт бота, сможет им
# пользоваться от вашего имени и за ваш счёт. Кому можно — перечисляется в
# TELEGRAM_ALLOWED_USERS в начале файла.
# GATEWAY_ALLOW_ALL_USERS=

# Адрес удалённого сервера агента, которому пересылать сообщения (режим
# посредника). Когда указан, местный шлюз занимается только мессенджерами,
# а всю работу делает удалённая машина. Настраивается и в config.yaml,
# gateway.proxy_url.
# GATEWAY_PROXY_URL=

# Токен для того же удалённого сервера. Должен совпадать с API_SERVER_KEY
# на нём.
# GATEWAY_PROXY_KEY=

# Пускать в Telegram кого угодно, не спрашивая (true/false, по умолчанию
# false). Оставьте выключенным: список тех, кому можно, задаётся строкой
# TELEGRAM_ALLOWED_USERS в начале файла.
# TELEGRAM_ALLOW_ALL_USERS=

# Как называть в сообщениях чат из строки TELEGRAM_HOME_CHANNEL. Чисто для
# читаемости: если не заполнено, агент показывает номер чата.
# TELEGRAM_HOME_CHANNEL_NAME=

# Номер темы в чате-форуме, куда складывать результаты задач по
# расписанию. Нужен, только если чат из строки TELEGRAM_HOME_CHANNEL
# разбит на темы: без него ответы уходят в общую ленту.
# TELEGRAM_CRON_THREAD_ID=

# ──────────────────────────────────────────────────────────────────────────
# Ключи для отдельных навыков (4)
# ──────────────────────────────────────────────────────────────────────────

# Notion integration token (used by the `notion` skill)
#   https://www.notion.so/my-integrations
# NOTION_API_KEY=

# Linear personal API key (used by the `linear` skill)
#   https://linear.app/settings/account/security
# LINEAR_API_KEY=

# Airtable personal access token (used by the `airtable` skill)
#   https://airtable.com/create/tokens
# AIRTABLE_API_KEY=

# Tenor API key for GIF search (used by the `gif-search` skill)
#   https://developers.google.com/tenor/guides/quickstart
# TENOR_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Служебные (3)
# обычные настройки поведения живут не здесь, а в config.yaml — в этом
# файле только секреты
# ──────────────────────────────────────────────────────────────────────────

# Path to JSON file with ephemeral prefill messages for few-shot priming
# HERMES_PREFILL_MESSAGES_FILE=

# Ephemeral system prompt injected at API-call time (never persisted to
# sessions)
# HERMES_EPHEMERAL_SYSTEM_PROMPT=

# Raft agent profile slug — auto-enables the adapter when set
# RAFT_PROFILE=
